# Copy this file to gcp/cloud_run/cloud_run.env.local.yaml for real deploys.
# Keep live secrets out of tracked files.
GCP_PROJECT_ID: soulfuljourney
GCP_ZONE: us-central1-f
GCP_INSTANCE_NAME: soulfuljourneyserver
TARGET_INSTANCE_ID: soulfuljourneyserver
SERVER_ALLOCATION_MODE: single-instance
SERVER_ALLOCATION_STORE: firestore
LOBBY_ALLOCATION_COLLECTION: serverLobbyAllocations
SAVE_DOCUMENT_COLLECTION: gameSessionSaves
MANAGED_INSTANCE_TEMPLATE: ""
MANAGED_INSTANCE_NAME_PREFIX: lobby-
MANAGED_INSTANCE_DESCRIPTION_PREFIX: Ephemeral dedicated lobby server
MANAGED_INSTANCE_METADATA_TARGET_ID_KEY: game-server-target-id
MANAGED_INSTANCE_METADATA_LOBBY_CODE_KEY: game-server-lobby-code
SERVER_PORT: "7777"
MAX_PLAYERS: "4"
GAME_TRANSPORT_MODE: direct
RELAY_CONNECTION_TYPE: dtls
SERVER_RUNTIME_HEARTBEAT_TTL_SECONDS: "20"
SERVER_WARMUP_SECONDS: "15"
JOIN_TICKET_TTL_SECONDS: "90"
JOIN_TICKET_SCOPE: join
SERVER_ADDRESS_OVERRIDE: ""
REQUIRE_PUBLIC_ADDRESS: "true"
ALLOW_ANONYMOUS_JOIN_TICKETS: "false"
OIDC_REQUIRED_ISSUER: https://securetoken.google.com/soulfuljourney
OIDC_REQUIRED_AUDIENCE: soulfuljourney
OIDC_REQUIRED_SCOPE: ""
OIDC_REQUIRED_GROUP: ""
FIREBASE_TOKEN_CLOCK_SKEW_SECONDS: "30"

# Required secret values:
# JOIN_TICKET_SECRET: "<set in cloud_run.env.local.yaml or via --update-secrets>"
# SERVER_REGISTRATION_TOKEN: "<optional; omit to fall back to JOIN_TICKET_SECRET>"